# Copy to .env and fill in. .env is git-ignored.
# Census API key (free): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Optional: also write GBFS snapshots to a local Postgres (leave empty for Parquet only)
# e.g. postgresql://khushi@localhost:5432/gbfs
POSTGRES_DSN=
# Optional: where the collector stores data (default: data/gbfs inside the repo)
GBFS_DATA_DIR=
